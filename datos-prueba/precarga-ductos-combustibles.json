    "pipelineSystems": [
      { "id": "SYS-GLP-101", "name": "Poliducto GLP Propano/Butano — Fraccionadora Costa → Planta de Envasado", "operator": "Transportes Líquidos S.A.", "product": "products", "dnIn": 6, "wallThicknessMm": 7.11, "material": "api5l-gr-b", "coating": "FBE + protección catódica", "lengthKm": 42, "stationFromKm": 0, "stationToKm": 42, "notes": "GLP presurizado (propano/butano). Referencia real: presión de vapor del propano ≈2 200 kPa @55 °C y butano ≈220 kPa @20 °C; almacenamiento en esferas al 85 % máximo por expansión térmica. Gas más denso que el aire: detección en puntos bajos. Normas: ASME B31.4, GPA 2140/EN 589.", "createdAt": "2026-10-16T12:00:00Z", "updatedAt": "2026-10-16T12:00:00Z" },
      { "id": "SYS-GAS93-97-201", "name": "Poliducto Gasolinas 93/97 — Refinería Costa → Terminal Norte", "operator": "Transportes Líquidos S.A.", "product": "products", "dnIn": 10, "wallThicknessMm": 9.27, "material": "api5l-x52", "coating": "FBE", "lengthKm": 88, "stationFromKm": 0, "stationToKm": 88, "notes": "Gasolinas RON 93 y 97 en bachas segregadas por octanaje (referencia EN 228 / especificación local). Interfase entre bachas gestionada por válvulas de cierre rápido (referencia real Colonial Pipeline: reducción de interfaz de 2 400 a 120 barriles por maniobra).", "createdAt": "2026-10-16T12:00:00Z", "updatedAt": "2026-10-16T12:00:00Z" },
      { "id": "SYS-POLI-MULTI-301", "name": "Poliducto Multiproducto 12\" — Refinería Costa → Terminal Central (gasolinas 93/97, diésel, kerosene doméstico)", "operator": "Transportes Líquidos S.A.", "product": "products", "dnIn": 12, "wallThicknessMm": 9.53, "material": "api5l-x52", "coating": "FBE + CP", "lengthKm": 156, "stationFromKm": 0, "stationToKm": 156, "notes": "Transporte por bachas de gasolina 93/97, diésel ULSD (EN 590) y kerosene doméstico (SKO). Referencia real: poliductos multiproducto mueven 15–20 productos regulares con envíos fungibles y segregados (Colonial Pipeline, 3–5 mph de velocidad de bacha).", "createdAt": "2026-10-16T12:00:00Z", "updatedAt": "2026-10-16T12:00:00Z" },
      { "id": "SYS-DSL-401", "name": "Poliducto de Diésel ULSD — Terminal Central → Central Térmica", "operator": "Transportes Líquidos S.A.", "product": "products", "dnIn": 8, "wallThicknessMm": 8.18, "material": "api5l-x52", "coating": "FBE", "lengthKm": 34, "stationFromKm": 0, "stationToKm": 34, "notes": "Diésel ULSD azufre ≤10 ppm (EN 590). Puntos bajos con trampa de agua: la corrosión interna en líneas de producto se concentra en fondos y agua libre.", "createdAt": "2026-10-16T12:00:00Z", "updatedAt": "2026-10-16T12:00:00Z" },
      { "id": "SYS-JETA1-501", "name": "Poliducto Jet A-1 — Refinería Costa → Granja de Combustible Aeropuerto", "operator": "Transportes Líquidos S.A.", "product": "products", "dnIn": 8, "wallThicknessMm": 8.18, "material": "api5l-x52", "coating": "FBE", "lengthKm": 61, "stationFromKm": 0, "stationToKm": 61, "notes": "Línea DEDICADA a kerosene de aviación Jet A-1 (DEF STAN 91-091 / ASTM D1655). Sin FAME/biodiésel: contaminación prohibida (práctica real de segregación — Colonial Pipeline). Filtración filtro/separador EI 1581 y sistema hidrante EI 1540 en terminal.", "createdAt": "2026-10-16T12:00:00Z", "updatedAt": "2026-10-16T12:00:00Z" },
      { "id": "SYS-SKO-601", "name": "Poliducto Kerosene Doméstico — Refinería Costa → Planta de Distribución", "operator": "Transportes Líquidos S.A.", "product": "products", "dnIn": 6, "wallThicknessMm": 7.11, "material": "api5l-gr-b", "coating": "FBE", "lengthKm": 27, "stationFromKm": 0, "stationToKm": 27, "notes": "Kerosene doméstico (SKO) para calefacción e iluminación. Tanques de terminal con venteo y control de agua libre.", "createdAt": "2026-10-16T12:00:00Z", "updatedAt": "2026-10-16T12:00:00Z" }
    ],
